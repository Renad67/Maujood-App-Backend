PORT=5000
NODE_ENV=development

# Database
DB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/moujood?retryWrites=true&w=majority

# JWT & QR Security
JWT_SECRET=your_super_secret_jwt_key
JWT_EXPIRES_IN=7d
QR_HMAC_SECRET=your_hmac_secret_for_qr_signing

# Cloud Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email (SMTP / Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=noreply@moujood.net

# Firebase Cloud Messaging (FCM)
FIREBASE_PROJECT_ID=moujood-firebase-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@moujood.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Live Payment Gateway (Stripe)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
FRONTEND_URL=http://localhost:3000

# Social OAuth (Google & Facebook)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

